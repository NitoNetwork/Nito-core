Use arc4random_stir instead of the deprecated arc4random_addrandom on macOS.

This matches current upstream libevent behavior for system arc4random
implementations while preserving the existing fallback on other platforms.

--- a/evutil_rand.c
+++ b/evutil_rand.c
@@ -195,7 +195,13 @@ void
 evutil_secure_rng_add_bytes(const char *buf, size_t n)
 {
+#if defined(__APPLE__) && defined(EVENT__HAVE_ARC4RANDOM)
+	(void)buf;
+	(void)n;
+	arc4random_stir();
+#else
 	arc4random_addrandom((unsigned char*)buf,
 	    n>(size_t)INT_MAX ? INT_MAX : (int)n);
+#endif
 }
 #endif
 
