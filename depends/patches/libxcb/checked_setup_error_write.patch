+static void write_setup_error(const char *message, int length)
+{
+    static const char newline = '\n';
+
+    while(length > 0)
+    {
+        int written = write(STDERR_FILENO, message, length);
+        if(written < 0 && errno == EINTR)
+            continue;
+        if(written <= 0)
+            return;
+        message += written;
+        length -= written;
+    }
+
+    while(write(STDERR_FILENO, &newline, 1) < 0 && errno == EINTR)
+        ;
+}
